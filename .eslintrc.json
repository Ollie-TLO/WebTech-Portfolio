{
  "env": {
    "es2021": true
  },
"globals": {
    // only put truly global constants here, e.g.,
    "myAllowedGlobal": "readonly"
},
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "warn",
    "no-unused-vars": ["warn", { "args": "none" }],
    "semi": ["error", "always"],
    "quotes": ["error", "double"],
    "indent": ["error", "tab"],
    "strict": ["error", "global"],   // require strict mode globally
    "no-undef": "error"              // error for undefined variables
  }
}
